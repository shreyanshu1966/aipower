{%- capture section_settings -%}
{
  "autoPlay": {{ section.settings.autoplay | json }},
  "prevNextButtons": false,
  "pageDots": {% if section.blocks.size > 1 %}true{% else %}false{% endif %},
  "setGallerySize": {% if section.settings.section_size == 'preserve_ratio' %}true{% else %}false{% endif %},
  "adaptiveHeight": {% if section.settings.section_size == 'preserve_ratio' %}true{% else %}false{% endif %},
  "transitionEffect": {{ section.settings.carousel_effect | json }},
  "cycleSpeed": {{ section.settings.cycle_speed | times: 1000 | json }}
}
{%- endcapture -%}

<section data-section-id="{{ section.id }}" data-section-type="hero-slider" data-section-settings="{{ section_settings | escape_once }}">
  <div {% unless section.settings.edge_to_edge %}class="container container--flush"{% endunless %}>
    <div class="slideshow slideshow--{{ section.settings.section_size | replace: '_', '-' }} {% if section.settings.edge_to_edge %}slideshow--edge2edge{% endif %}" style="color: {{ section.blocks.first.settings.text_color }}">
      {%- for block in section.blocks -%}
        {%- capture slide_inner -%}
          <div class="slideshow__slide-inner">
            {%- unless block.settings.image -%}
              {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
              {%- if section.settings.section_size == 'preserve_ratio' -%}
                {{- placeholder | placeholder_svg_tag: 'slideshow__image-placeholder' -}}
              {%- else -%}
                <div class="slideshow__placeholder">
                  {{- placeholder | placeholder_svg_tag: 'slideshow__image-placeholder' -}}
                </div>
              {%- endif -%}
            {%- endunless -%}

            {%- if block.settings.image -%}
              {%- liquid
                if forloop.first
                  assign loading_strategy = nil
                  assign fetch_priority = 'high'
                else
                  assign loading_strategy = 'lazy'
                  assign fetch_priority = 'low'
                endif
              -%}
              {%- capture class_attribute -%}slideshow__image {% unless section.settings.section_size == 'preserve_ratio' %}image-background{% endunless %}{%- endcapture -%}
              <div class="{% if block.settings.mobile_image %}hidden-phone{% endif %}">
                {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, fetchpriority: fetch_priority, widths: '200,300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400', class: class_attribute -}}
              </div>
              {%- if block.settings.mobile_image -%}
                <div class="hidden-tablet-and-up">
                  {{- block.settings.mobile_image | image_url: width: block.settings.mobile_image.width | image_tag: loading: loading_strategy, fetchpriority: fetch_priority, widths: '200,300,400,600,800,1000,1200,1400,1600,1800,2000,2200,2400', class: class_attribute -}}
                </div>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <div class="slideshow__elem slideshow__elem--title"
                style="--elem-x:{{ block.settings.title_pos_x }}%;--elem-y:{{ block.settings.title_pos_y }}%;--elem-mob-x:{{ block.settings.title_mob_x }}%;--elem-mob-y:{{ block.settings.title_mob_y }}%;--fs:{{ block.settings.title_size }}px;--fs-mob:{{ block.settings.title_mob_size }}px;text-align:{{ block.settings.title_align }};">
                <h2 class="slideshow__title heading h1">{{ block.settings.title | escape }}</h2>
              </div>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="slideshow__elem slideshow__elem--subtext"
                style="--elem-x:{{ block.settings.text_pos_x }}%;--elem-y:{{ block.settings.text_pos_y }}%;--elem-mob-x:{{ block.settings.text_mob_x }}%;--elem-mob-y:{{ block.settings.text_mob_y }}%;--fs:{{ block.settings.text_size }}px;--fs-mob:{{ block.settings.text_mob_size }}px;text-align:{{ block.settings.content_align }};">
                <p class="slideshow__content">{{ block.settings.content | escape | newline_to_br }}</p>
              </div>
            {%- endif -%}

            {%- if block.settings.button_text != blank and block.settings.link != blank -%}
              <div class="slideshow__elem slideshow__elem--buttons"
                style="--elem-x:{{ block.settings.btn_pos_x }}%;--elem-y:{{ block.settings.btn_pos_y }}%;--elem-mob-x:{{ block.settings.btn_mob_x }}%;--elem-mob-y:{{ block.settings.btn_mob_y }}%;--btn-scale:{{ block.settings.btn_scale | divided_by: 100.0 }};--btn-mob-scale:{{ block.settings.btn_mob_scale | divided_by: 100.0 }};">
                <div class="slideshow__button-group slideshow__button-group--{{ block.settings.btn_align }}">
                  <a href="{{ block.settings.link }}" class="slideshow__button button">{{ block.settings.button_text | escape }}</a>
                  {%- if block.settings.secondary_button_text != blank and block.settings.secondary_button_link != blank -%}
                    <a href="{{ block.settings.secondary_button_link }}" class="slideshow__button slideshow__button--ghost">{{ block.settings.secondary_button_text | escape }}</a>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            <style>
              #block-{{ block.id }} { color: {{ block.settings.text_color }}; }
              #block-{{ block.id }} .button {
                color: {{ block.settings.button_text_color }};
                background: {{ block.settings.button_background }};
              }
              #block-{{ block.id }} .button:hover {
                background: {{ block.settings.button_background | color_modify: 'alpha', 0.8 }};
              }
              {%- if block.settings.show_overlay -%}
                #block-{{ block.id }}.slideshow__slide--overlay::before {
                  {%- assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0 -%}
                  background: linear-gradient(to bottom, rgba(0,0,0,0), {{ '#000000' | color_modify: 'alpha', overlay_opacity }});
                }
              {%- endif -%}
            </style>
          </div>
        {%- endcapture -%}

        {%- if block.settings.link != blank and block.settings.button_text == blank -%}
          <a href="{{ block.settings.link }}" class="slideshow__slide {% if block.settings.show_overlay %}slideshow__slide--overlay{% endif %} {% if forloop.first %}is-selected{% endif %}" id="block-{{ block.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {{- slide_inner -}}
          </a>
        {%- else -%}
          <div class="slideshow__slide {% if block.settings.show_overlay %}slideshow__slide--overlay{% endif %} {% if forloop.first %}is-selected{% endif %}" id="block-{{ block.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {{- slide_inner -}}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-counter" id="hero-counter-{{ section.id }}" aria-hidden="true">
      <span class="hero-counter__cur">01</span>
      <span class="hero-counter__line"></span>
      <span class="hero-counter__tot">0{{ section.blocks.size }}</span>
    </div>
    <div class="hero-prog" id="hero-prog-{{ section.id }}" aria-hidden="true">
      <div class="hero-prog__fill" id="hero-prog-fill-{{ section.id }}"></div>
    </div>
  {%- endif -%}
</section>

<style>
  /* ── Global scroll-reveal ─────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
  .reveal--delay-1 { transition-delay: 0.1s; }
  .reveal--delay-2 { transition-delay: 0.2s; }
  .reveal--delay-3 { transition-delay: 0.32s; }

  /* ── Slideshow ────────────────────────────────────────── */
  [data-section-type="hero-slider"] { position: relative; }

  /* ── Individual element absolute positioning ──────────── */
  /* Each element is anchored by its centre at (--elem-x, --elem-y). */
  /* 0% = left/top edge · 50% = centre · 100% = right/bottom edge   */
  .slideshow__elem {
    position: absolute;
    left: var(--elem-x, 50%);
    top:  var(--elem-y, 50%);
    transform: translate(-50%, -50%);
    z-index: 2;
    width: max-content;
    max-width: min(82%, 780px);
    box-sizing: border-box;
    padding: 0 10px;
  }

  .slideshow__title {
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    font-size: var(--fs, 52px);
  }

  .slideshow__content {
    opacity: 0.88;
    max-width: 560px;
    margin: 0;
    font-size: var(--fs, 16px);
  }

  /* ── Button group ─────────────────────────────────────── */
  .slideshow__button-group {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }
  .slideshow__button-group--left   { justify-content: flex-start; }
  .slideshow__button-group--center { justify-content: center; }
  .slideshow__button-group--right  { justify-content: flex-end; }

  /* ── Button scale (whole button, not just text) ───────── */
  .slideshow__elem--buttons {
    transform: translate(-50%, -50%) scale(var(--btn-scale, 1));
    transform-origin: center center;
  }

  .slideshow__button--ghost {
    display: inline-block;
    padding: 11px 24px;
    background: transparent;
    color: currentColor;
    border: 1px solid rgba(255, 255, 255, 0.55);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .slideshow__button--ghost:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.9);
  }

  /* ── Slide counter ────────────────────────────────────── */
  .hero-counter {
    position: absolute;
    top: 22px;
    right: 28px;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    pointer-events: none;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  .hero-counter__line {
    display: block;
    width: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.45);
  }

  /* ── Progress bar ─────────────────────────────────────── */
  .hero-prog {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 30;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-prog__fill { height: 100%; width: 0%; background: #e60000; }

  @keyframes hero-prog-anim {
    from { width: 0%; }
    to   { width: 100%; }
  }

  /* ── Mobile overrides ─────────────────────────────────── */
  @media screen and (max-width: 640px) {
    .hero-counter { top: 14px; right: 16px; }

    /* Switch to mobile-specific positions */
    .slideshow__elem {
      left: var(--elem-mob-x, 50%);
      top:  var(--elem-mob-y, 50%);
      max-width: 90%;
      width: 90%;
    }

    .slideshow__elem--buttons {
      transform: translate(-50%, -50%) scale(var(--btn-mob-scale, 1));
    }

    .slideshow__title {
      font-size: var(--fs-mob, 22px) !important;
      line-height: 1.2;
    }
    .slideshow__content {
      font-size: var(--fs-mob, 14px);
      line-height: 1.5;
    }

    .slideshow__button-group {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      width: 100%;
    }
    .slideshow__button-group .button,
    .slideshow__button-group .slideshow__button,
    .slideshow__button-group .slideshow__button--ghost {
      text-align: center;
      width: 100%;
      padding: 13px 16px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 480px) {
    .slideshow__title { font-size: 19px !important; }
  }
</style>

<script>
  (function() {
    var sId = '{{ section.id }}';
    var total = {{ section.blocks.size }};
    var speed = {{ section.settings.cycle_speed | times: 1000 }};
    var autoPlay = {{ section.settings.autoplay | json }};

    document.addEventListener('DOMContentLoaded', function() {
      var sec = document.querySelector('[data-section-id="' + sId + '"]');
      if (!sec) return;

      var curEl   = document.querySelector('#hero-counter-' + sId + ' .hero-counter__cur');
      var fill    = document.getElementById('hero-prog-fill-' + sId);
      var slides  = sec.querySelectorAll('.slideshow__slide');

      function pad(n) { return n < 10 ? '0' + n : '' + n; }

      function startProg() {
        if (!fill || !autoPlay) return;
        fill.style.animation = 'none';
        fill.offsetHeight;
        fill.style.animation = 'hero-prog-anim ' + (speed / 1000) + 's linear forwards';
      }

      function onSelect(idx) {
        if (curEl) curEl.textContent = pad(idx + 1);
        startProg();
      }

      if (slides.length > 1) {
        var observer = new MutationObserver(function(muts) {
          muts.forEach(function(m) {
            if (m.attributeName === 'class' && m.target.classList.contains('is-selected')) {
              var idx = Array.prototype.indexOf.call(slides, m.target);
              onSelect(idx);
            }
          });
        });
        slides.forEach(function(s) {
          observer.observe(s, { attributes: true, attributeFilter: ['class'] });
        });
        startProg();
      }

      /* ── Scroll reveal ── */
      var revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12 });
        revealEls.forEach(function(el) { io.observe(el); });
      } else {
        revealEls.forEach(function(el) { el.classList.add('is-visible'); });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "edge_to_edge",
      "label": "Full-width",
      "default": false
    },
    {
      "type": "select",
      "id": "section_size",
      "label": "Image size",
      "options": [
        {
          "value": "preserve_ratio",
          "label": "Original image ratio"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "preserve_ratio"
    },
    {
      "type": "select",
      "id": "carousel_effect",
      "label": "Transition effect",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "default": "slide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between slides",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "2160 x 720px .jpg recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "750 x 1100px .jpg recommended. If none is set, desktop image will be used."
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show overlay",
          "info": "Increase text readability on busy images.",
          "default": false
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30,
          "visible_if": "{{ block.settings.show_overlay }}"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Slide title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "Tell your story"
        },
        {
          "type": "header",
          "content": "Heading position"
        },
        {
          "type": "paragraph",
          "content": "0% = left \/ top edge · 50% = centre · 100% = right \/ bottom edge. Desktop and mobile are set independently."
        },
        {
          "type": "range",
          "id": "title_pos_x",
          "label": "Desktop — left \/ right",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "range",
          "id": "title_pos_y",
          "label": "Desktop — up \/ down",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 38,
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Desktop font size",
          "min": 16, "max": 120, "step": 2, "unit": "px",
          "default": 52,
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "select",
          "id": "title_align",
          "label": "Heading text align",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "center",
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "range",
          "id": "title_mob_x",
          "label": "Mobile — left \/ right",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "range",
          "id": "title_mob_y",
          "label": "Mobile — up \/ down",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 32,
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "range",
          "id": "title_mob_size",
          "label": "Mobile font size",
          "min": 12, "max": 72, "step": 2, "unit": "px",
          "default": 22,
          "visible_if": "{{ block.settings.title != blank }}"
        },
        {
          "type": "header",
          "content": "Subtext position"
        },
        {
          "type": "range",
          "id": "text_pos_x",
          "label": "Desktop — left \/ right",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "range",
          "id": "text_pos_y",
          "label": "Desktop — up \/ down",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 52,
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Desktop font size",
          "min": 10, "max": 48, "step": 1, "unit": "px",
          "default": 16,
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "select",
          "id": "content_align",
          "label": "Subtext text align",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "center",
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "range",
          "id": "text_mob_x",
          "label": "Mobile — left \/ right",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "range",
          "id": "text_mob_y",
          "label": "Mobile — up \/ down",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 46,
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "range",
          "id": "text_mob_size",
          "label": "Mobile font size",
          "min": 10, "max": 32, "step": 1, "unit": "px",
          "default": 14,
          "visible_if": "{{ block.settings.content != blank }}"
        },
        {
          "type": "header",
          "content": "Buttons position"
        },
        {
          "type": "range",
          "id": "btn_pos_x",
          "label": "Desktop — left \/ right",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "range",
          "id": "btn_pos_y",
          "label": "Desktop — up \/ down",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 65,
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "range",
          "id": "btn_scale",
          "label": "Desktop button size",
          "min": 50, "max": 200, "step": 5, "unit": "%",
          "default": 100,
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "select",
          "id": "btn_align",
          "label": "Button row align",
          "info": "How buttons sit relative to each other when there are two.",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "center",
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "range",
          "id": "btn_mob_x",
          "label": "Mobile — left \/ right",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "range",
          "id": "btn_mob_y",
          "label": "Mobile — up \/ down",
          "min": 0, "max": 100, "step": 1, "unit": "%",
          "default": 62,
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "range",
          "id": "btn_mob_scale",
          "label": "Mobile button size",
          "min": 50, "max": 200, "step": 5, "unit": "%",
          "default": 100,
          "visible_if": "{{ block.settings.button_text != blank }}"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Background",
          "default": "#ffffff"
        },
