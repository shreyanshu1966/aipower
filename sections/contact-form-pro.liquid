      "id": "show_subject_field",
      "label": "Show subject field",
      "default": true
    },
    {
      "type": "text",
      "id": "subject_field_label",
      "label": "Subject field label",
      "default": "Subject"
    },
    {
      "type": "header",
      "content": "Info card"
    },
